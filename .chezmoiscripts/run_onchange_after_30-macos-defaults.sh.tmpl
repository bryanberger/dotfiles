#!/bin/bash
{{- if eq .chezmoi.os "darwin" }}
{{- template "assert-profile" . }}
set -euo pipefail

# macOS system settings. `run_onchange_` = re-runs only when this file changes.
#
# Profile: {{ .profile }}. Blocks marked "personal only" are omitted entirely on
# a work machine — a managed Mac has MDM policy and backup/DLP rules that these
# writes would either fight or silently lose to.
#
# Every line here was chosen deliberately; the
# baseline was read off the 2026 MacBook Pro with `defaults read`, then a few
# well-known dev tweaks layered on. To add a setting: change it in System
# Settings, find the key with `defaults read <domain>`, add the line here.
#
# Caveat: some domains are TCC-protected on macOS 15+. A `defaults write` that
# silently no-ops will show up as an unchanged `defaults read` — verify after
# the first run rather than assuming.

echo "==> Applying macOS defaults"

###############################################################################
# Keyboard & input
###############################################################################

# Fastest repeat macOS accepts. System Settings' slider bottoms out at
# KeyRepeat=2 / InitialKeyRepeat=15; writing 1 and 10 goes below the UI floor.
# This is the standard vim/nvim setting — held j/k moves at full speed.
defaults write NSGlobalDomain KeyRepeat -int 1
defaults write NSGlobalDomain InitialKeyRepeat -int 10

# Holding a key repeats it instead of opening the accent-character popover.
# Required for hjkl navigation to work in Electron editors (Cursor, VS Code).
defaults write NSGlobalDomain ApplePressAndHoldEnabled -bool false

###############################################################################
# Trackpad & scrolling
###############################################################################

defaults write com.apple.AppleMultitouchTrackpad Clicking -bool true
defaults write com.apple.driver.AppleBluetoothMultitouch.trackpad Clicking -bool true
defaults -currentHost write NSGlobalDomain com.apple.mouse.tapBehavior -int 1
defaults write NSGlobalDomain com.apple.mouse.tapBehavior -int 1

# Traditional scroll direction (content moves with the scrollbar, not the finger).
defaults write NSGlobalDomain com.apple.swipescrolldirection -bool false

###############################################################################
# Dock
###############################################################################

defaults write com.apple.dock autohide -bool true
defaults write com.apple.dock tilesize -int 38
# Zero delay + fast animation: the Dock appears the instant you hit the edge.
defaults write com.apple.dock autohide-delay -float 0
defaults write com.apple.dock autohide-time-modifier -float 0.15
defaults write com.apple.dock show-recents -bool false

# Hot corners: 1 = disabled. Bottom-right is easy to hit by accident.
defaults write com.apple.dock wvous-br-corner -int 1
defaults write com.apple.dock wvous-br-modifier -int 0

###############################################################################
# Finder
###############################################################################

defaults write NSGlobalDomain AppleShowAllExtensions -bool true
defaults write com.apple.finder FXPreferredViewStyle -string "clmv"  # column view
defaults write com.apple.finder ShowPathbar -bool true
defaults write com.apple.finder ShowStatusBar -bool true
defaults write com.apple.finder NewWindowTarget -string "PfHm"       # new windows open at ~
defaults write com.apple.finder FXDefaultSearchScope -string "SCcf"  # search the current folder

# Stop littering .DS_Store files on network shares and USB drives.
defaults write com.apple.desktopservices DSDontWriteNetworkStores -bool true
defaults write com.apple.desktopservices DSDontWriteUSBStores -bool true

{{ if eq .profile "personal" -}}
###############################################################################
# Screenshots (personal only — a managed Mac's backup/DLP policy is keyed to
# Desktop and Documents, so don't move captures out from under IT)
###############################################################################

mkdir -p "$HOME/Screenshots"
defaults write com.apple.screencapture location -string "$HOME/Screenshots"
defaults write com.apple.screencapture type -string "png"
defaults write com.apple.screencapture disable-shadow -bool true
{{- end }}

###############################################################################
# General UI & dialogs
###############################################################################

defaults write NSGlobalDomain AppleInterfaceStyle -string "Dark"

# Save and print panels open expanded, not in the cramped one-line form.
defaults write NSGlobalDomain NSNavPanelExpandedStateForSaveMode -bool true
defaults write NSGlobalDomain NSNavPanelExpandedStateForSaveMode2 -bool true
defaults write NSGlobalDomain PMPrintingExpandedStateForPrint -bool true
defaults write NSGlobalDomain PMPrintingExpandedStateForPrint2 -bool true

# New documents default to local disk rather than iCloud Drive.
defaults write NSGlobalDomain NSDocumentSaveNewDocumentsToCloud -bool false

###############################################################################
# Menu bar
###############################################################################

defaults write com.apple.menuextra.clock ShowDayOfWeek -bool true

{{ if eq .profile "personal" -}}
###############################################################################
# Security (personal only — on a work Mac these are MDM-enforced, and writing
# them is a no-op at best)
###############################################################################

# Password required immediately when the screen sleeps or the saver kicks in.
# macOS 15 often prefers the System Settings value over these keys — check
# System Settings > Lock Screen after the first run and fix by hand if needed.
defaults write com.apple.screensaver askForPassword -int 1
defaults write com.apple.screensaver askForPasswordDelay -int 0
{{- end }}

###############################################################################
# Restart affected apps
###############################################################################

for app in "Dock" "Finder" "SystemUIServer"; do
	killall "${app}" >/dev/null 2>&1 || true
done

echo "==> macOS defaults applied. Some settings need a logout to fully take effect."
{{- end }}
